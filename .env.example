# Base da API, sem o caminho final. Exemplos:
#   Gemini:  https://generativelanguage.googleapis.com/v1beta/openai/
#   Ollama:  http://localhost:11434/v1
LLM_API_BASE_URL=https://seu-servidor/v1

# Caminho do endpoint de chat (opcional; padrão: /chat/completions).
LLM_API_PATH=/chat/completions

# Chave da API. Pode ficar vazia em servidores sem autenticação (ex.: Ollama local).
LLM_API_KEY=sua_chave_aqui

# Nome do modelo, como o provedor o identifica.
LLM_MODEL_NAME=nome-do-modelo

# Parâmetros de geração.
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1000

# Tempo máximo de espera, em segundos (opcional; padrão: 30).
LLM_TIMEOUT=30